/* 文件管理页样式 */

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.filter-item {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.06);
}

.filter-item.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: var(--color-text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  color: var(--color-text-secondary);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
}

.file-list {
  padding-bottom: 120rpx;
}

.file-card {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.08);
  display: flex;
  align-items: center;
}

.file-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.file-image {
  width: 100%;
  height: 100%;
}

.file-icon {
  width: 100%;
  height: 100%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.file-info {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: var(--color-text);
  display: block;
  margin-bottom: 8rpx;
}

.file-meta {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.file-actions {
  flex-shrink: 0;
}

.action-btn.delete {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--color-danger);
  background: #FEF2F2;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1E3A5F, #2D5A8E);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 58, 95, 0.3);
  z-index: 100;
}
