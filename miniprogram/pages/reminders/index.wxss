/* 提醒列表页样式 */

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: var(--color-text-secondary);
}

.reminder-list {
  padding-bottom: 120rpx;
}

.reminder-card {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.08);
}

.reminder-card.completed {
  opacity: 0.6;
}

.reminder-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reminder-type-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.type-label {
  margin-left: 8rpx;
  font-weight: 500;
}

.reminder-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.action-btn.complete {
  color: var(--color-success);
  background: #ECFDF5;
}

.action-btn.delete {
  color: var(--color-danger);
  background: #FEF2F2;
}

.reminder-body {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.reminder-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 12rpx;
}

.reminder-notes {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 16rpx;
}

.reminder-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reminder-date {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.reminder-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.reminder-badge.normal {
  background: #DBEAFE;
  color: var(--color-primary);
}

.reminder-badge.warning {
  background: #FEF3C7;
  color: #D97706;
}

.reminder-badge.urgent {
  background: #FEE2E2;
  color: var(--color-danger);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1E3A5F, #2D5A8E);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 58, 95, 0.3);
  z-index: 100;
}
