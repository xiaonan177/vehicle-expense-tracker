/* 添加提醒页样式 */

.form-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.08);
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 16rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-btn {
  flex: 1;
  min-width: 28%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  background: var(--color-bg);
  border: 2rpx solid transparent;
}

.type-btn.active {
  background: #EFF6FF;
  border-color: var(--color-primary);
}

.type-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.type-text {
  font-size: 24rpx;
  color: var(--color-text);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg);
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.picker-input {
  display: flex;
  align-items: center;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg);
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1E3A5F, #2D5A8E);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 40rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}
