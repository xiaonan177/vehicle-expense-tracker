/* 首页样式 */

.header {
  padding: 32rpx 0;
  text-align: center;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
  display: block;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  display: block;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: var(--color-text-secondary);
}

/* 总花费卡片 */
.total-card {
  background: linear-gradient(135deg, #1E3A5F, #2D5A8E);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  color: #FFFFFF;
}

.total-label {
  font-size: 28rpx;
  opacity: 0.8;
  display: block;
}

.total-amount {
  font-size: 64rpx;
  font-weight: 700;
  margin: 16rpx 0 32rpx;
  display: block;
}

.total-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 8rpx;
  display: block;
}

/* 视图切换 */
.view-toggle {
  display: flex;
  background: var(--color-card);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}

.toggle-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.toggle-btn.active {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
}

/* 年度视图 */
.category-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.category-item {
  flex: 1;
  min-width: 30%;
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.08);
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin: 0 auto 12rpx;
}

.category-icon.fuel { background: #EFF6FF; }
.category-icon.maintenance { background: #FFFBEB; }
.category-icon.purchase { background: #EEF2FF; }
.category-icon.paperwork { background: #F5F3FF; }
.category-icon.insurance { background: #ECFDF5; }

.category-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: block;
}

.category-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-top: 8rpx;
  display: block;
}

/* 图表卡片 */
.chart-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.08);
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 32rpx;
}

.chart-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding-bottom: 40rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.chart-bar-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}

.chart-bar {
  width: 40rpx;
  background: linear-gradient(180deg, #3B82F6, #1E3A5F);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 20rpx;
}

.chart-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
  position: absolute;
  bottom: 0;
}

/* 月度视图 */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-primary);
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.08);
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.month-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.month-stat-item {
  flex: 1;
  min-width: 45%;
  background: var(--color-card);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.08);
}

.month-stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: block;
}

.month-stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-top: 8rpx;
  display: block;
}

/* 费用列表 */
.expenses-list {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 24rpx;
}

.expense-item {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.06);
}

.expense-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 24rpx;
}

.expense-info {
  flex: 1;
}

.expense-desc {
  font-size: 28rpx;
  color: var(--color-text);
  display: block;
}

.expense-date {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  display: block;
}

.expense-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 提醒区域 */
.reminders-section {
  margin-bottom: 120rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-accent);
}

.empty-reminders {
  text-align: center;
  padding: 40rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.06);
}

.reminder-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #FEF3C7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 24rpx;
}

.reminder-info {
  flex: 1;
}

.reminder-title {
  font-size: 28rpx;
  color: var(--color-text);
  display: block;
}

.reminder-date {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  display: block;
}

.reminder-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #DBEAFE;
  font-size: 22rpx;
  color: var(--color-primary);
}

.reminder-badge.urgent {
  background: #FEE2E2;
  color: var(--color-danger);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1E3A5F, #2D5A8E);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 58, 95, 0.3);
  z-index: 100;
}
