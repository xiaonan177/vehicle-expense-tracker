<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="header-title">车辆管家</text>
    <text class="header-subtitle">费用统计与到期提醒</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 主内容 -->
  <view wx:else>
    <!-- 总花费卡片 -->
    <view class="total-card">
      <text class="total-label">总花费</text>
      <text class="total-amount">{{stats.total || '฿0.00'}}</text>
      <view class="total-stats">
        <view class="stat-item">
          <text class="stat-value">{{stats.fuel_count || 0}}</text>
          <text class="stat-label">加油次数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.maintenance_count || 0}}</text>
          <text class="stat-label">维修次数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.total_count || 0}}</text>
          <text class="stat-label">总记录</text>
        </view>
      </view>
    </view>

    <!-- 视图切换 -->
    <view class="view-toggle">
      <view class="toggle-btn {{viewMode === 'year' ? 'active' : ''}}" bindtap="switchToYear">
        <text>年度</text>
      </view>
      <view class="toggle-btn {{viewMode === 'month' ? 'active' : ''}}" bindtap="switchToMonth">
        <text>月度</text>
      </view>
    </view>

    <!-- 年度视图 -->
    <view wx:if="{{viewMode === 'year'}}" class="year-view">
      <!-- 类别统计 -->
      <view class="category-stats">
        <view class="category-item">
          <view class="category-icon fuel">⛽</view>
          <text class="category-label">加油</text>
          <text class="category-value">{{stats.fuel_total || '฿0.00'}}</text>
        </view>
        <view class="category-item">
          <view class="category-icon maintenance">🔧</view>
          <text class="category-label">维修</text>
          <text class="category-value">{{stats.maintenance_total || '฿0.00'}}</text>
        </view>
        <view class="category-item">
          <view class="category-icon purchase">🚗</view>
          <text class="category-label">购车</text>
          <text class="category-value">{{stats.purchase_total || '฿0.00'}}</text>
        </view>
        <view class="category-item">
          <view class="category-icon paperwork">📋</view>
          <text class="category-label">手续</text>
          <text class="category-value">{{stats.paperwork_total || '฿0.00'}}</text>
        </view>
        <view class="category-item">
          <view class="category-icon insurance">🛡️</view>
          <text class="category-label">保险费</text>
          <text class="category-value">{{stats.insurance_total || '฿0.00'}}</text>
        </view>
      </view>

      <!-- 月度趋势图 -->
      <view class="chart-card">
        <text class="chart-title">{{currentYear}}年月度花费趋势</text>
        <view class="chart-container">
          <view wx:for="{{monthlyStats}}" wx:key="month" class="chart-bar-wrapper" bindtap="selectMonth" data-month="{{item.month}}">
            <view class="chart-bar" style="height: {{item.total > 0 ? Math.max(item.total / 100, 20) : 20}}rpx;"></view>
            <text class="chart-label">{{item.month}}月</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 月度视图 -->
    <view wx:if="{{viewMode === 'month'}}" class="month-view">
      <!-- 月份导航 -->
      <view class="month-nav">
        <view class="nav-btn" bindtap="prevMonth">‹</view>
        <text class="month-title">{{currentYear}}年{{currentMonth}}月</text>
        <view class="nav-btn" bindtap="nextMonth">›</view>
      </view>

      <!-- 月度类别统计 -->
      <view class="month-stats">
        <view class="month-stat-item">
          <text class="month-stat-label">加油</text>
          <text class="month-stat-value">{{stats.fuel_total || '฿0.00'}}</text>
        </view>
        <view class="month-stat-item">
          <text class="month-stat-label">维修</text>
          <text class="month-stat-value">{{stats.maintenance_total || '฿0.00'}}</text>
        </view>
        <view class="month-stat-item">
          <text class="month-stat-label">购车</text>
          <text class="month-stat-value">{{stats.purchase_total || '฿0.00'}}</text>
        </view>
        <view class="month-stat-item">
          <text class="month-stat-label">手续</text>
          <text class="month-stat-value">{{stats.paperwork_total || '฿0.00'}}</text>
        </view>
        <view class="month-stat-item">
          <text class="month-stat-label">保险费</text>
          <text class="month-stat-value">{{stats.insurance_total || '฿0.00'}}</text>
        </view>
      </view>

      <!-- 当月费用明细 -->
      <view class="expenses-list">
        <text class="section-title">当月费用明细</text>
        <view wx:if="{{monthExpenses.length === 0}}" class="empty-state">
          <text class="empty-icon">📭</text>
          <text class="empty-text">暂无费用记录</text>
        </view>
        <view wx:for="{{monthExpenses}}" wx:key="id" class="expense-item">
          <view class="expense-icon" style="background: {{item.type === 'fuel' ? '#EFF6FF' : item.type === 'maintenance' ? '#FFFBEB' : item.type === 'purchase' ? '#EEF2FF' : item.type === 'paperwork' ? '#F5F3FF' : '#ECFDF5'}};">
            <text>{{item.type === 'fuel' ? '⛽' : item.type === 'maintenance' ? '🔧' : item.type === 'purchase' ? '🚗' : item.type === 'paperwork' ? '' : '🛡️'}}</text>
          </view>
          <view class="expense-info">
            <text class="expense-desc">{{item.description || '无描述'}}</text>
            <text class="expense-date">{{item.expense_date}}</text>
          </view>
          <text class="expense-amount">{{item.amount}}</text>
        </view>
      </view>
    </view>

    <!-- 即将到期提醒 -->
    <view class="reminders-section">
      <view class="section-header">
        <text class="section-title">即将到期</text>
        <text class="section-more" bindtap="goToReminders">查看全部 ›</text>
      </view>
      <view wx:if="{{reminders.length === 0}}" class="empty-reminders">
        <text>暂无到期提醒</text>
      </view>
      <view wx:for="{{reminders}}" wx:key="id" class="reminder-item">
        <view class="reminder-icon">
          <text>{{item.type === 'fuel' ? '⛽' : item.type === 'maintenance' ? '🔧' : item.type === 'inspection' ? '' : item.type === 'insurance' ? '🛡️' : '🔩'}}</text>
        </view>
        <view class="reminder-info">
          <text class="reminder-title">{{item.title}}</text>
          <text class="reminder-date">{{item.due_date}}</text>
        </view>
        <view class="reminder-badge {{item.days_remaining <= 7 ? 'urgent' : ''}}">
          <text>{{item.days_remaining}}天</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 浮动按钮 -->
  <view class="fab" bindtap="addExpense">
    <text>+</text>
  </view>
</view>
