{
  "version": 2,
  "builds": [
    {
      "src": "server/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/src/index.ts"
    }
  ],
  "buildCommand": "cd server && pnpm install --no-frozen-lockfile && pnpm build",
  "installCommand": "cd server && pnpm install --no-frozen-lockfile"
}
